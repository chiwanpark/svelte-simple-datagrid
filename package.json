{
	"name": "@chiwanpark/svelte-simple-datagrid",
	"version": "0.0.1",
	"description": "A simple, lightweight datagrid component for Svelte 5.",
	"license": "MIT",
	"author": "Chiwan Park <chiwanpark@hotmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chiwanpark/svelte-simple-datagrid.git"
	},
	"homepage": "https://chiwanpark.github.io/svelte-simple-datagrid/",
	"bugs": "https://github.com/chiwanpark/svelte-simple-datagrid/issues",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "dprint check && oxlint",
		"format": "dprint fmt",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"changeset": "changeset",
		"release:version": "changeset version && pnpm install --lockfile-only",
		"release:tag": "changeset git-tag"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./xlsx": {
			"types": "./dist/xlsx/index.d.ts",
			"default": "./dist/xlsx/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"write-excel-file": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"write-excel-file": {
			"optional": true
		}
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"dprint": "0.57.4",
		"fflate": "^0.8.3",
		"jsdom": "^30.0.1",
		"oxlint": "1.85.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"write-excel-file": "^4.1.1"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"datagrid",
		"data-table",
		"table",
		"component"
	]
}
